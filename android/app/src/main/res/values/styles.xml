<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/shu</item>
        <item name="colorPrimaryDark">@color/shu</item>
        <item name="colorAccent">@color/shu</item>
    </style>

    <!-- アプリの画面。ステータスバー・ナビゲーションバーは画面上部の帯と同じ朱色（文字・アイコンは白） -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/shu</item>
        <item name="android:statusBarColor">@color/shu</item>
        <item name="android:navigationBarColor">@color/shu</item>
    </style>

    <!-- 起動時のスプラッシュ画面（生成り色の背景にアイコン） -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/kinari</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
